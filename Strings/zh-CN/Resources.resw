<?xml version="1.0" encoding="utf-8"?>
<!--
  Localised strings for the package itself.

  These are what Windows shows outside the app: the Start menu, Settings > Apps,
  Alt+Tab and the window list. The in-app titlebar is translated by i18n, but
  that has no effect here, because the shell reads the package manifest and the
  manifest needs a resource it can point at.

  Referenced from Package.appxmanifest as ms-resource:AppName and
  ms-resource:AppDescription, and compiled into resources.pri by makepri.

  The folder path and this language tag must match the Resource Language entries
  in the manifest, or the lookup silently falls back to the default.

  Note: an XML comment may not contain a double hyphen. Writing one here
  invalidates the whole file, and makepri then reports "root node not found",
  which points nowhere near the actual cause.
-->
<root>
  <resheader name="resmimetype">
    <value>text/microsoft-resx</value>
  </resheader>
  <resheader name="version">
    <value>2.0</value>
  </resheader>
  <resheader name="reader">
    <value>System.Resources.ResXResourceReader, System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089</value>
  </resheader>
  <resheader name="writer">
    <value>System.Resources.ResXResourceWriter, System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089</value>
  </resheader>

  <data name="AppName" xml:space="preserve">
    <value>FM 电台</value>
  </data>
  <data name="AppDescription" xml:space="preserve">
    <value>Radio Browser 桌面客户端</value>
  </data>
</root>