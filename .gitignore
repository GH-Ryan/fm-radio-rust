# Rust build output
/target/

# Tauri generated schemas
/gen/

# Frontend build output and dependencies
/dist/
node_modules/

# Editor and OS noise
*.swp
.DS_Store

# Signing material. The dev certificate is self-signed with a known password,
# so committing it would let anyone mint packages that look like they came from
# this publisher on a machine that trusts it. MSIX also needs the certificate in
# LocalMachine\Root, which means a leaked one is actually installable.
*.pfx
*.p12
*.pem
*.key

# MSIX build output. msix/stage/ is the packaging staging directory: it holds a
# copy of the binary, the built assets, the .msix itself, and the dev certificate.
/msix/
*.msix
*.msixbundle

# icon.ico is regenerated by tools/New-OpaqueIco.ps1; the .bak predates the
# opaque rebuild and carries the rounded transparent corners the rebuild removed.
*.bak
