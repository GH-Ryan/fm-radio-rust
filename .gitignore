# Rust build output and Tauri generated schemas
/src-tauri/target/
/src-tauri/gen/

# Frontend build output and dependencies
/dist/
node_modules/

# Editor and OS noise
*.swp
.DS_Store

# Signing material. The dev certificate is self-signed with a known password,
# so committing it would let anyone mint packages that look like they came from
# this publisher on a machine that trusts it. MSIX also needs the certificate in
# LocalMachine\Root, which means a leaked one is actually installable.
*.pfx
*.p12
*.pem
*.key

# Signed packages and bundles. Packaging stages under src-tauri/target/msix-stage,
# which the Cargo rule above already covers; the deliverables are copied to
# release/ and are not tracked either. The rest of msix/ is package source.
*.msix
*.msixbundle

# Backups left by manual edits.
*.bak

# Deliverables. tools/Build-Release.cmd and tools/build/New-MsixPackage.ps1 copy
# the executable and the signed package here; everything else they produce is an
# intermediate under src-tauri/target.
/release/
