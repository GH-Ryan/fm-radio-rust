{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FM 电台",
  "version": "0.1.0",
  "identifier": "com.fmradio.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "dist"
  },
  "app": {
    "windows": [
      {
        "title": "FM 电台",
        "width": 1040,
        "height": 700,
        "minWidth": 400,
        "minHeight": 480,
        "decorations": false,
        "backgroundColor": "#0e0f13",
        "label": "main",
        "additionalBrowserArgs": "--disable-gpu --disable-gpu-compositing --disable-features=WebGPU,Vulkan"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}